# Server-only key for geocoding, Places and Routing.
GEOAPIFY_API_KEY=YOUR_SERVER_KEY

# Public browser key: configure allowed origins in Geoapify MyProjects.
NEXT_PUBLIC_MAP_STYLE_BRIGHT=https://maps.geoapify.com/v1/styles/osm-bright/style.json?apiKey=YOUR_BROWSER_KEY
NEXT_PUBLIC_MAP_STYLE_DARK=https://maps.geoapify.com/v1/styles/dark-matter/style.json?apiKey=YOUR_BROWSER_KEY
