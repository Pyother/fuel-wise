{
  "inputs": [
    {
      "type": "promptString",
      "id": "geoapify-api-key",
      "description": "Geoapify API key",
      "password": true
    }
  ],
  "servers": {
    "geoapify": {
      "type": "http",
      "url": "https://api.geoapify.com/v1/mcp",
      "headers": {
        "x-api-key": "${input:geoapify-api-key}"
      }
    }
  }
}
